    function buildPortionOptions(foodData as Lang.Array) as Lang.Array {
        var portions = [] as Lang.Array;

        portions.add({
            :label => foodData[4] as Lang.String,
            :calories => foodData[5] as Lang.Number,
        });
        portions.add({
            :label => foodData[6] as Lang.String,
            :calories => foodData[7] as Lang.Number,
        });
        portions.add({
            :label => foodData[8] as Lang.String,
            :calories => foodData[9] as Lang.Number,
        });
        portions.add({
            :label => foodData[10] as Lang.String,
            :calories => foodData[11] as Lang.Number,
        });

        return portions;
    }

    function buildMenuFood(foodData as Lang.Array) as Lang.Dictionary {
        return (
            ({
                :id => foodData[0] as Lang.Symbol,
                :storageId => foodData[1] as Lang.String,
                :name => foodData[2] as Lang.String,
                :category => foodData[3] as Lang.String,
            }) as Lang.Dictionary
        );
    }

    function buildFood(foodData as Lang.Array) as Lang.Dictionary {
        return (
            ({
                :id => foodData[0] as Lang.Symbol,
                :storageId => foodData[1] as Lang.String,
                :name => foodData[2] as Lang.String,
                :category => foodData[3] as Lang.String,
                :portionOptions => buildPortionOptions(foodData),
            }) as Lang.Dictionary
        );
    }

    function getFoods() as Lang.Array {
        var foods = [] as Lang.Array;

        for (var index = 0; index < FOOD_DATA.size(); index += 1) {
            foods.add(buildMenuFood(FOOD_DATA[index] as Lang.Array));
        }

        return foods;
    }

    //essa função retorna um array contendo todos os alimentos disponíveis no catálogo FOODS. Cada alimento é representado como um dicionário que inclui informações como ID, nome, categoria e opções de porção com seus respectivos valores calóricos.
    function getFoodsByCategory(category as Lang.String) as Lang.Array {
        var foodsInCategory = [] as Lang.Array;

        for (var index = 0; index < FOOD_DATA.size(); index += 1) {
            var foodData = FOOD_DATA[index] as Lang.Array;

            var foodCategory = foodData[3] as Lang.String;

            if (foodCategory.equals(category)) {
                foodsInCategory.add(buildMenuFood(foodData));
            }
        }

        return foodsInCategory;
    }

    //essa função retorna um array contendo todas as categorias de alimentos presentes no catálogo FOODS. Ela percorre todos os alimentos e adiciona cada categoria única ao array categories, garantindo que não haja duplicatas.
    function getCategories() as Lang.Array {
        var categories = [] as Lang.Array;

        for (var index = 0; index < FOOD_DATA.size(); index += 1) {
            var foodData = FOOD_DATA[index] as Lang.Array;
            var category = foodData[3] as Lang.String;

            var categoryExists = false;

            for (
                var categoryIndex = 0;
                categoryIndex < categories.size();
                categoryIndex += 1
            ) {
                var savedCategory = categories[categoryIndex] as Lang.String;

                if (savedCategory.equals(category)) {
                    categoryExists = true;
                    break;
                }
            }

            if (!categoryExists) {
                categories.add(category);
            }
        }

        return categories;
    }

    function getFood(foodId as Lang.Symbol) as Lang.Dictionary? {
        for (var index = 0; index < FOOD_DATA.size(); index += 1) {
            var foodData = FOOD_DATA[index] as Lang.Array;

            if (foodData[0] == foodId) {
                return buildFood(foodData as Lang.Array);
            }
        }

        return null;
    }
}
